{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "trackers", "enabled": true, "path": "rules/trackers.json" },
      { "id": "supplementary", "enabled": true, "path": "rules/supplementary.json" }
    ]
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "DecoyShield"
  },
  "options_page": "options/index.html",
  "background": {
    "service_worker": "service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/main-world/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {}
}
